# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_GRAPH_VERSION=v26.0

# OpenAI-compatible Hermes/model endpoint
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=
HERMES_SYSTEM_PROMPT=

# Conversation memory and persistent handover state
MEMORY_API_URL=https://memory.gravityarena.co.za
MEMORY_API_KEY=replace-with-memory-api-key

# Brevo lead capture and escalation email
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_LEAD_LIST_ID=8
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gravity Arena Hermes
HUMAN_ESCALATION_EMAIL=

# Human handover controls
HUMAN_HANDOVER_KEYWORDS=human,agent,person,someone,call me,phone me,complaint,manager,refund,quotation,quote,urgent,escalate,speak to
HUMAN_HANDOVER_REPLY=I have alerted the Gravity Arena team. A team member will contact you as soon as possible.
HUMAN_HANDOVER_CONTROL_KEY=replace-with-a-long-random-control-secret
