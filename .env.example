BREVO_API_KEY=replace_with_a_brevo_api_key
BREVO_MASTER_LIST_ID=replace_with_the_numeric_master_list_id
BREVO_LEAD_LIST_ID=replace_with_the_numeric_whatsapp_lead_list_id
BREVO_SENDER_EMAIL=hello@gravityarena.co.za
BREVO_SENDER_NAME=Gravity Arena Hermes
HUMAN_ESCALATION_EMAIL=tech@gravityarena.co.za
HUMAN_HANDOVER_KEYWORDS=human,agent,person,call me,complaint,manager,refund,quotation,quote,urgent,speak to
HUMAN_HANDOVER_REPLY=I have alerted the Gravity Arena team. A team member will contact you as soon as possible.

MEMORY_API_URL=https://memory.gravityarena.co.za
MEMORY_API_KEY=replace_with_the_memory_api_key

WHATSAPP_VERIFY_TOKEN=replace_with_the_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=replace_with_the_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_the_official_phone_number_id
META_GRAPH_VERSION=v26.0

HERMES_API_URL=https://api.openai.com/v1/chat/completions
HERMES_API_KEY=replace_with_the_openai_api_key
HERMES_MODEL=gpt-5.1
HERMES_SYSTEM_PROMPT=replace_with_the_approved_gravity_arena_prompt

ALLOWED_ORIGINS=https://gravityarena.co.za,https://www.gravityarena.co.za

