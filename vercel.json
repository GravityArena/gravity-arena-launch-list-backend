{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/launch-list.js": {
      "maxDuration": 10
    },
    "api/booking-reminders.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 20
    },
    "api/health-monitor.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/booking-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/health-monitor",
      "schedule": "*/5 * * * *"
    }
  ]
}
